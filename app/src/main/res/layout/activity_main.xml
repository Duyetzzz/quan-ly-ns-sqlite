<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/pale" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:background="@color/navy" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:text="QUẢN LÝ NHÂN SỰ" android:textColor="@color/white" android:textStyle="bold" android:textSize="24sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="K23DTCN532 – Hà Văn Duyệt" android:textColor="#C8DBFA" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:orientation="vertical">
  <TextView android:id="@+id/txtStatistics" android:background="@drawable/card_bg" android:padding="14dp" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtSearch" android:layout_marginTop="10dp" android:background="@drawable/field_bg" android:padding="12dp" android:singleLine="true" android:hint="Tìm theo mã, họ tên, quê quán, phòng ban..." android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Spinner android:id="@+id/spDepartment" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="48dp"/>
  <Spinner android:id="@+id/spSort" android:layout_width="match_parent" android:layout_height="48dp"/>
  <Button android:id="@+id/btnAdd" android:text="+ THÊM NHÂN SỰ" android:textColor="@color/white" android:background="@drawable/primary_bg" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="50dp"/>
 </LinearLayout>
 <TextView android:id="@+id/txtEmpty" android:gravity="center" android:text="Chưa có nhân sự phù hợp" android:textColor="@color/muted" android:visibility="gone" android:padding="30dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <ListView android:id="@+id/listEmployees" android:divider="@android:color/transparent" android:dividerHeight="10dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>